# 复制到 outputs/mbencha_full_evaluation/vlm.env 后填写，并执行 chmod 600。
# 此文件仅为模板，不要把真实 API key 提交到 Git。

MBENCH_VLM_BASE_URL="http://127.0.0.1:8000/v1"
MBENCH_VLM_API_KEY="replace-with-real-key"
MBENCH_VLM_MODEL="Qwen/Qwen2.5-VL-72B-Instruct"
MBENCH_VLM_ENDPOINT_PATH="/chat/completions"
MBENCH_VLM_API_STYLE="chat_completions"
MBENCH_VLM_MAX_TOKENS="512"
